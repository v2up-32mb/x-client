<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        X Client 应用主题（Material 3）。
        颜色全部来自 values[-night]/colors.xml 的语义 token；
        状态栏/导航栏跟随 surface，禁止硬编码。
        主题切换（light/dark/system）由 ThemeManager 经 AppCompatDelegate 承接。
    -->
    <style name="Theme.XClient" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/x_primary</item>
        <item name="colorOnPrimary">@color/x_on_primary</item>
        <item name="colorPrimaryContainer">@color/x_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/x_on_primary_container</item>

        <!-- Secondary/Tertiary 未定制品牌色，继承 M3 默认；显式绑定 primary 保持界面收敛 -->
        <item name="colorSecondary">@color/x_primary</item>
        <item name="colorOnSecondary">@color/x_on_primary</item>

        <!-- Surface / Background -->
        <item name="android:colorBackground">@color/x_background</item>
        <item name="colorSurface">@color/x_surface</item>
        <item name="colorOnSurface">@color/x_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/x_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/x_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/x_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/x_surface_container_high</item>
        <item name="colorSurfaceContainerLowest">@color/x_surface_container_lowest</item>

        <!-- Outline -->
        <item name="colorOutline">@color/x_outline</item>
        <item name="colorOutlineVariant">@color/x_outline_variant</item>

        <!-- Error -->
        <item name="colorError">@color/x_error</item>
        <item name="colorOnError">@color/x_on_error</item>
        <item name="colorErrorContainer">@color/x_error_container</item>
        <item name="colorOnErrorContainer">@color/x_on_error_container</item>

        <!-- 系统栏：跟随 surface 角色（night 下自动切换），windowLight* 在 values-night 覆写 -->
        <item name="android:statusBarColor">@color/x_surface</item>
        <item name="android:navigationBarColor">@color/x_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Toolbar 溢出菜单弹层 -->
    <style name="ThemeOverlay.XClient" parent="ThemeOverlay.Material3.Light" />

    <!-- ===== 组件样式族（Component 层） ===== -->
    <style name="Widget.XClient" parent="" />

    <style name="Widget.XClient.Button" parent="Widget.Material3.Button" />

    <style name="Widget.XClient.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton" />

    <style name="Widget.XClient.TextButton" parent="Widget.Material3.Button.TextButton" />

    <style name="Widget.XClient.Card" parent="Widget.Material3.CardView.ElevatedCard">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.XClient.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

    <style name="Widget.XClient.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
