<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing scale：4dp 步进（8pt 网格）。布局 margin/padding 只允许引用本档位。 -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">12dp</dimen>
    <dimen name="spacing_lg">16dp</dimen>
    <dimen name="spacing_xl">24dp</dimen>
    <dimen name="spacing_xxl">32dp</dimen>

    <!-- 触控目标最小值（Android 平台 48dp） -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- 微徽章紧凑垂直边距（用于标签文本光学居中） -->
    <dimen name="badge_padding_vertical">2dp</dimen>

    <!-- 响应式屏幕内容水平内边距（防横向过度拉伸） -->
    <dimen name="screen_content_padding_horizontal">16dp</dimen>
</resources>
