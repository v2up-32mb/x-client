<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="?attr/xPrimary" />
            <solid android:color="?attr/xSurfaceContainerHigh" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="?attr/xPrimary" />
            <solid android:color="?attr/xSurfaceContainerHigh" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/xOutlineVariant" />
            <solid android:color="?attr/xSurfaceContainerLow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/xOutlineVariant" />
            <solid android:color="?attr/xSurfaceContainerLowest" />
        </shape>
    </item>
</selector>
