<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_xs">

    <!-- ===== 卡片 1：参考节点与参数配置 ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/xOutlineVariant"
        app:cardBackgroundColor="?attr/xSurfaceContainerLow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferred_reference_title"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/xOnSurface" />

            <!-- 节点选择 Spinner 容器 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/xOutlineVariant"
                app:cardBackgroundColor="?attr/xSurface">

                <Spinner
                    android:id="@+id/preferred_reference"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/preferred_target" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 目标参数摘要 -->
            <TextView
                android:id="@+id/preferred_reference_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/xOnSurfaceVariant"
                android:fontFamily="monospace" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:background="?attr/xOutlineVariant" />

            <!-- 探测参数：双列紧凑并排 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.XClient.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:hint="@string/preferred_sample_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/preferred_sample_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.XClient.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:hint="@string/preferred_concurrency_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/preferred_concurrency_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 卡片 2：测试看板 Dashboard ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/xOutlineVariant"
        app:cardBackgroundColor="?attr/xSurfaceContainerLow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- 顶部阶段与网络标签 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preferred_phase_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:text="@string/preferred_ready"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/xOnSurface" />

                <TextView
                    android:id="@+id/preferred_network_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:text="@string/preferred_direct_net"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/xOnSurfaceVariant" />
            </LinearLayout>

            <!-- 三指标数据卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/xOutlineVariant"
                    app:cardBackgroundColor="?attr/xSurfaceContainerLowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_sm">

                        <TextView
                            android:id="@+id/preferred_metric_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 0"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/xOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preferred_metric_completed_total"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/xOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/xOutlineVariant"
                    app:cardBackgroundColor="?attr/xSurfaceContainerLowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_sm">

                        <TextView
                            android:id="@+id/preferred_metric_success"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/mdSuccess" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preferred_metric_success_nodes"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/xOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/xOutlineVariant"
                    app:cardBackgroundColor="?attr/xSurfaceContainerLowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_sm">

                        <TextView
                            android:id="@+id/preferred_metric_selected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/xPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preferred_metric_checked_nodes"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/xOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 下载测速额度信息行 -->
            <TextView
                android:id="@+id/preferred_ledger_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/xOnSurfaceVariant" />

            <!-- 单行状态提示文本 -->
            <TextView
                android:id="@+id/preferred_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/xPrimary"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 主操作按钮 ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/preferred_primary"
        style="@style/Widget.XClient.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/spacing_md"
        app:icon="@drawable/ic_speed"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        android:text="@string/preferred_start_test" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:text="@string/preferred_test_footer_hint"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/xOnSurfaceVariant" />

    <!-- 候选列表标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="@string/preferred_candidate_nodes"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/xOnSurface" />

</LinearLayout>
