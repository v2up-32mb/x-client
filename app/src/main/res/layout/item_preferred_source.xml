<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/xOutlineVariant"
    app:cardBackgroundColor="?attr/xSurfaceContainerLow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_xs"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs">

        <!-- 勾选框 -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/source_checkbox"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/preferred_enable_source" />

        <!-- 来源名称与数据量 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/source_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/xOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/source_count_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:paddingTop="@dimen/badge_padding_vertical"
                    android:paddingBottom="@dimen/badge_padding_vertical"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/xOnSurfaceVariant" />

                <TextView
                    android:id="@+id/source_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/xOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧操作图标组：刷新 + 垃圾桶删除 -->
        <ImageButton
            android:id="@+id/btn_refresh_source"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_icon_button_focus"
            android:contentDescription="@string/preferred_refresh_source"
            android:focusable="true"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/xPrimary" />

        <ImageButton
            android:id="@+id/btn_delete_source"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_icon_button_focus"
            android:contentDescription="@string/preferred_delete_source"
            android:focusable="true"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_delete"
            app:tint="?attr/xError" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
