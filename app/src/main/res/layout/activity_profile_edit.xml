<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 配置名称 -->
        <TextView android:text="配置名称"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingTop="8dp"/>
        <EditText android:id="@+id/profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="配置名称"
            android:singleLine="true"/>

        <!-- 代理协议 -->
        <TextView android:text="@string/protocol_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingTop="8dp"/>
        <Spinner android:id="@+id/protocol_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ==================== GCM 协议字段 ==================== -->
        <LinearLayout
            android:id="@+id/gcm_fields"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- WSS 服务器地址 -->
            <TextView android:text="@string/worker_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="8dp"/>
            <EditText android:id="@+id/worker_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="wss://example.com"
                android:singleLine="true"/>

            <!-- 优选 IP -->
            <TextView android:text="@string/pref_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="16dp"/>
            <EditText android:id="@+id/pref_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1.1.1.1,8.8.8.8"
                android:singleLine="true"/>

            <!-- 用户 ID -->
            <TextView android:text="@string/user_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="16dp"/>
            <EditText android:id="@+id/user_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="用户ID"
                android:singleLine="true"/>

            <!-- 出口代理 IP -->
            <TextView android:text="@string/fallback_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="16dp"/>
            <EditText android:id="@+id/fallback_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1.1.1.1,8.8.8.8"
                android:singleLine="true"/>

            <!-- 配置级选项 -->
            <TextView
                android:text="配置选项"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"/>

            <CheckBox android:id="@+id/disable_ech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disable_ech"/>

            <CheckBox android:id="@+id/disable_ipv6_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disable_ipv6_route"/>

            <TextView android:text="@string/ws_conn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="12dp"/>
            <EditText android:id="@+id/ws_conn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="3"
                android:inputType="number"
                android:singleLine="true"/>

            <CheckBox android:id="@+id/enable_dynamic_pool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_dynamic_pool"/>

            <TextView android:text="@string/dynamic_pool_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="12dp"/>
            <EditText android:id="@+id/dynamic_pool_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="16"
                android:inputType="number"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- ==================== X-Tunnel 协议字段 ==================== -->
        <LinearLayout
            android:id="@+id/xtunnel_fields"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView android:text="@string/xt_server_addr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="8dp"/>
            <EditText android:id="@+id/xt_server_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="wss://tunnel.example.com:8443"
                android:singleLine="true"/>

            <TextView android:text="@string/xt_token"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="16dp"/>
            <EditText android:id="@+id/xt_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Token"
                android:singleLine="true"/>

            <TextView android:text="@string/xt_relay_nodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="16dp"/>
            <EditText android:id="@+id/xt_relay_nodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="relay1.example.com:443,relay2.example.com"
                android:singleLine="true"/>

            <TextView android:text="@string/xt_connections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingTop="16dp"/>
            <EditText android:id="@+id/xt_connections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="3"
                android:inputType="number"
                android:singleLine="true"/>

            <TextView
                android:text="配置选项"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"/>

            <CheckBox android:id="@+id/xt_disable_ech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disable_ech"/>

            <!-- ECH 查询域名与 DoH 服务器复用全局设置（SettingsActivity） -->

            <CheckBox android:id="@+id/xt_insecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xt_insecure"/>

            <CheckBox android:id="@+id/xt_enable_hot_pair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xt_enable_hot_pair"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/xt_hot_pair_count"
                android:textStyle="bold"/>
            <EditText android:id="@+id/xt_hot_pair_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1"
                android:inputType="number"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/xt_advanced_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/xt_advanced_params"
                android:textStyle="bold"/>

            <LinearLayout android:id="@+id/xt_advanced_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_backpressure"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_backpressure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="8"
                    android:inputType="number"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_write_queue_wait"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_write_queue_wait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="100"
                    android:inputType="number"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_dial_timeout"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_dial_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="3"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_handshake_timeout"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_handshake_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="5"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_read_timeout"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_read_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="15"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_write_timeout"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_write_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="5"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_ping_interval"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_ping_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="5"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_reconnect_delay"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_reconnect_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_connect_timeout"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_connect_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="15"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_max_socks5"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_max_socks5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1024"
                    android:inputType="number"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/xt_adv_udp_ports"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/xt_adv_udp_ports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="443"
                    android:inputType="text"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 导入按钮 -->
        <Button android:id="@+id/btn_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="导入配置"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:textSize="16sp"/>

        <!-- 保存按钮 -->
        <Button android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>
