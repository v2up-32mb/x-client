<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 全局设置标题 -->
        <TextView
            android:text="全局设置"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="16dp"/>

        <!-- 代理模式 -->
        <TextView
            android:text="代理模式"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <CheckBox android:id="@+id/checkbox_global"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="全局代理"/>

        <TextView
            android:text="勾选为全局代理，不勾选为分应用代理"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:paddingBottom="8dp"/>

        <Button android:id="@+id/button_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择应用"
            android:backgroundTint="#9C27B0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:text="@string/bypass_routes"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkbox_bypass_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bypass_private" />

        <CheckBox
            android:id="@+id/checkbox_bypass_geoip_cn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bypass_geoip_cn" />

        <CheckBox
            android:id="@+id/checkbox_bypass_geosite_cn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bypass_geosite_cn" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/manual_bypass_rules"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edittext_bypass_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/manual_bypass_rules_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="4"
            android:maxLines="10"
            android:scrollbars="vertical" />

        <!-- 本地代理端口 -->
        <TextView android:text="本地代理端口"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingTop="16dp"/>
        <EditText android:id="@+id/edittext_socks_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1080"
            android:inputType="number"
            android:singleLine="true"/>

        <!-- GCM 全局网络参数 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:text="GCM 全局网络设置"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ech_dns"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edittext_ech_dns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://doh.pub/dns-query"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/ech_domain"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edittext_ech_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cloudflare-ech.com"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/ws_conn"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edittext_ws_conn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3"
            android:inputType="number"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/checkbox_enable_dns_warmup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_dns_warmup" />

        <CheckBox
            android:id="@+id/checkbox_enable_dynamic_pool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_dynamic_pool" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dynamic_pool_max" />
        <EditText
            android:id="@+id/edittext_dynamic_pool_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="16"
            android:inputType="number"
            android:singleLine="true" />

        <!-- 保存按钮 -->
        <Button android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>
