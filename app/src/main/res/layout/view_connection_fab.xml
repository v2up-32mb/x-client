<?xml version="1.0" encoding="utf-8"?>
<!--
    VPN Connection FAB：compact（56×56 图标）↔ expanded（morph 为状态卡）。
    morph 规格：宽 56→≤300dp、高 56→minHeight 76dp（wrap_content 适配 fontScale）、圆角 28→16dp。
    五态配色见 docs/ui-ux/redesign-plan.md §6.5 与 docs/ui-ux/refine-ux-review.md §3。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView"
    tools:theme="@style/Theme.XClient">

    <LinearLayout
        android:id="@+id/fab_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <LinearLayout
            android:id="@+id/fab_text_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_md"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/fab_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="正在连接…" />

            <!-- 定宽滚动视口：节点名/错误信息单行滚动，滚完即收折（用户反馈精修） -->
            <HorizontalScrollView
                android:id="@+id/fab_subtitle_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/fab_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:singleLine="true"
                    tools:text="默认节点 · example.com" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/fab_error_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fab_retry"
                    style="@style/Widget.XClient.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:text="@string/common_retry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fab_details"
                    style="@style/Widget.XClient.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:text="@string/common_view_logs" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fab_icon_slot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clipChildren="false">
            <!-- clipChildren=false：进度圈描边沿 indicatorSize 圆周中心线绘制，
                 实际外径 = 24+trackThickness，需允许 1.5dp 对称溢出，否则圆环被裁切；
                 溢出对称，圆心仍在 FAB 正中 -->

            <ImageView
                android:id="@+id/fab_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_power" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/fab_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:indicatorSize="24dp"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </LinearLayout>
</merge>
