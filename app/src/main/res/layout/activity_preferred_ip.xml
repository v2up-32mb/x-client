<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/preferred_toolbar"
        style="@style/Widget.XClient.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/preferred_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/xOnSurface"
        app:title="@string/preferred_ip_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/preferred_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/xSurface"
        android:minHeight="@dimen/touch_target_min"
        android:nextFocusDown="@id/preferred_pager"
        app:tabGravity="fill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="?attr/xPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/xPrimary"
        app:tabTextColor="?attr/xOnSurfaceVariant" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/preferred_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nextFocusUp="@id/preferred_tabs" />

</LinearLayout>
