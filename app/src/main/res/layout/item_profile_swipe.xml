<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile 列表项（滑动操作）token 化重构（redesign-plan §8.1）：
    - 行高 56dp→64dp，触控目标达标；字号并入 M3 字阶
    - 滑动操作按钮按语义着色：分享/复制=中性 tonal，编辑=primaryContainer，删除=error
    - contentDescription 全部走字符串资源
-->
<com.x.client.app.SwipeRevealLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Foreground Layer: Profile Content -->
    <LinearLayout
        android:id="@+id/foreground_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical">

        <!-- 选中指示器 -->
        <RadioButton
            android:id="@+id/radio_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"/>

        <!-- 配置信息（两行） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:orientation="vertical">

            <!-- 配置名称 -->
            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/default_profile_name"/>

            <!-- 服务器地址 -->
            <TextView
                android:id="@+id/text_server_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="server.com"/>

        </LinearLayout>

        <!-- 协议类型标签（右下角） -->
        <TextView
            android:id="@+id/text_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginBottom="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="GCM"/>

    </LinearLayout>

    <!-- 分界线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorOutlineVariant"/>

    <!-- Overlay Layer: Action Buttons (显示在前景层上方) -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="end|top"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="@color/x_share_container"
            app:tint="@color/x_on_share_container"
            android:scaleType="centerInside"
            android:padding="@dimen/spacing_lg"
            android:contentDescription="@string/acc_share"/>

        <ImageButton
            android:id="@+id/btn_copy"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_action_copy"
            android:background="?attr/colorSurfaceContainerHigh"
            app:tint="?attr/colorOnSurface"
            android:scaleType="centerInside"
            android:padding="@dimen/spacing_lg"
            android:contentDescription="@string/acc_copy"/>

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/colorTertiaryContainer"
            app:tint="?attr/colorOnTertiaryContainer"
            android:scaleType="centerInside"
            android:padding="@dimen/spacing_lg"
            android:contentDescription="@string/acc_edit"/>

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/colorError"
            app:tint="?attr/colorOnError"
            android:scaleType="centerInside"
            android:padding="@dimen/spacing_lg"
            android:contentDescription="@string/acc_delete"/>
    </LinearLayout>

</com.x.client.app.SwipeRevealLayout>
