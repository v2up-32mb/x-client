<?xml version="1.0" encoding="utf-8"?>
<com.x.client.app.SwipeRevealLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Foreground Layer: Profile Content -->
    <LinearLayout
        android:id="@+id/foreground_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical">

        <!-- 选中指示器 -->
        <RadioButton
            android:id="@+id/radio_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"/>

        <!-- 配置信息（两行） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <!-- 配置名称 -->
            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="配置名称"/>

            <!-- 服务器地址 -->
            <TextView
                android:id="@+id/text_server_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/secondary_text"
                android:text="server.com"/>

        </LinearLayout>

        <!-- 协议类型标签（右下角） -->
        <TextView
            android:id="@+id/text_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:textSize="10sp"
            android:textColor="@color/secondary_text"
            android:text="GCM"/>

    </LinearLayout>

    <!-- 分界线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="@color/divider"/>

    <!-- Overlay Layer: Action Buttons (显示在前景层上方) -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="end|top"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="#4CAF50"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:contentDescription="分享"/>

        <ImageButton
            android:id="@+id/btn_copy"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_action_copy"
            android:background="#FF9800"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:contentDescription="复制"/>

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="#2196F3"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:contentDescription="修改"/>

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="#F44336"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:contentDescription="删除"/>
    </LinearLayout>

</com.x.client.app.SwipeRevealLayout>
