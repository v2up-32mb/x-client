<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The custom runner uses only android.app.Instrumentation. Do not inherit
             optional android.test libraries from a generated/merged test manifest. -->
        <uses-library android:name="android.test.runner" tools:node="remove" />
        <uses-library android:name="android.test.base" tools:node="remove" />
        <uses-library android:name="android.test.mock" tools:node="remove" />
    </application>
</manifest>
